{
  "name": "ben-vault-sync",
  "version": "2.0.0",
  "description": "Syncs an Obsidian vault with a GitHub repository.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "test": "esbuild test/run.ts --bundle --platform=node --format=cjs --outfile=test/run.cjs --alias:obsidian=./test/stub-obsidian.js --log-level=warning && node test/run.cjs",
    "preview": "esbuild test/preview.ts --bundle --platform=node --format=cjs --outfile=test/preview.cjs --alias:obsidian=./test/stub-obsidian.js --log-level=warning && node test/preview.cjs"
  },
  "keywords": [],
  "author": "Ben Wellendorf",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.9.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  }
}
